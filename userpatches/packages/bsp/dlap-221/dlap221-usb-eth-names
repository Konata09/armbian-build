#!/bin/bash
# Name the onboard RTL8153 ports by hub port: ports 3, 2 and 1 of the hub on
# xHCI root port 2 become eth1, eth2 and eth3, the order of their factory MAC
# addresses. The kernel numbers them in the order they bind, port 1 first.
# A .link file can not do this: udev can not swap two names, because the target
# name is still taken. Rename through temporary names before networkd starts.

ports=(2.3 2.2 2.1)

ifname() {
	local net
	for net in /sys/bus/usb/devices/*-"$1":1.0/net/*; do
		[[ -e "${net}" ]] && echo "${net##*/}" && return 0
	done
	return 1
}

# the ports normally bind before init starts; give a slow hub a few seconds
for _ in {1..50}; do
	missing=0
	for port in "${ports[@]}"; do
		ifname "${port}" > /dev/null || missing=1
	done
	((missing)) || break
	sleep 0.2
done
udevadm settle --timeout=10

rc=0
moved=()
for i in "${!ports[@]}"; do
	name=$(ifname "${ports[i]}") || continue
	[[ "${name}" == "eth$((i + 1))" ]] && continue
	ip link set dev "${name}" name "usbeth$((i + 1))" && moved+=($((i + 1))) || rc=1
done
for n in "${moved[@]}"; do
	ip link set dev "usbeth${n}" name "eth${n}" || rc=1
done
exit ${rc}
