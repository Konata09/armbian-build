index c1ec75aa4..607a61db4 100644
--- a/drivers/clk/hisilicon/Kconfig
+++ b/drivers/clk/hisilicon/Kconfig
@@ -1,4 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config COMMON_CLK_ASCEND310_CPU
+	tristate "Ascend 310 A55 cluster PLL driver"
+	depends on ARCH_HISI || COMPILE_TEST
+	help
+	  Build the driver for the PLL that clocks the A55 cluster of the
+	  HiSilicon Ascend 310 (Hi1910), so that cpufreq can change the CPU
