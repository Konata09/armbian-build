@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Stand-ins for the Ascend driver SDK helpers (drv_log, securec) used by the
+ * vendor higmac driver, so it builds as a normal in-tree driver.
+ */
+#ifndef __HIGMAC_COMPAT_H__
+#define __HIGMAC_COMPAT_H__
+
+#include <linux/kernel.h>
+#include <linux/minmax.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+#define CFG_SOC_PLATFORM_MINI
+
+#define EOK 0
+
+#define drv_err(mod, fmt, ...)	pr_err("%s: " fmt, mod, ##__VA_ARGS__)
+#define drv_warn(mod, fmt, ...)	pr_warn("%s: " fmt, mod, ##__VA_ARGS__)
+#define drv_info(mod, fmt, ...)	pr_info("%s: " fmt, mod, ##__VA_ARGS__)
+#define drv_debug(mod, fmt, ...) pr_debug("%s: " fmt, mod, ##__VA_ARGS__)
+
+static inline int memcpy_s(void *dest, size_t dest_max, const void *src,
+			   size_t count)
+{
+	if (count > dest_max)
+		return -EINVAL;
+	memcpy(dest, src, count);
+	return 0;
+}
+
+static inline int strncpy_s(char *dest, size_t dest_max, const char *src,
+			    size_t count)
+{
+	if (!dest_max)
+		return -EINVAL;
+	strscpy(dest, src, min(dest_max, count + 1));
+	return 0;
+}
+
+/* securec semantics: write at most @count chars, -1 on truncation */
+#define snprintf_s(buf, dest_max, count, fmt, ...)			\
+	({								\
+		size_t __lim = min_t(size_t, (dest_max), (count) + 1);	\
+		int __n = snprintf((buf), __lim, fmt, ##__VA_ARGS__);	\
+		(__n < 0 || (size_t)__n >= __lim) ? -1 : __n;		\
+	})
+
+#endif
