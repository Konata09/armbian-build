From 95ebd5af1fe552ddf71aee97af83f0222a33c0c8 Mon Sep 17 00:00:00 2001
From: "Claude (for konata09)" <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 12:40:32 +0800
Subject: [PATCH 1/9] mmc: dw_mmc: add HiSilicon Ascend 310 glue driver

Kirin-style DW-MSHC with the source clock, clock gate and reset in the
peripheral sub-control block and the 1.8 V pad bias in the system
controller. Timing values come from the vendor dw_mmc_hi3xxx driver.
---
 drivers/mmc/host/Kconfig            |  10 +
 drivers/mmc/host/Makefile           |   1 +
 drivers/mmc/host/dw_mmc-ascend310.c | 405 ++++++++++++++++++++++++++++
 3 files changed, 416 insertions(+)
 create mode 100644 drivers/mmc/host/dw_mmc-ascend310.c

diff --git a/drivers/mmc/host/Kconfig b/drivers/mmc/host/Kconfig
index c94ae4794..842782e77 100644
--- a/drivers/mmc/host/Kconfig
+++ b/drivers/mmc/host/Kconfig
@@ -844,6 +844,16 @@ config MMC_DW_HI3798MV200
 	  Synopsys DesignWare Memory Card Interface driver. Select this option
 	  for platforms based on HiSilicon Hi3798MV200 SoC.
 
+config MMC_DW_ASCEND310
+	tristate "HiSilicon Ascend 310 specific extensions for Synopsys DW Memory Card Interface"
+	depends on MMC_DW
+	depends on ARCH_HISI || COMPILE_TEST
+	select MMC_DW_PLTFM
+	help
+	  This selects support for the DW-MSHC SD controller of the HiSilicon
+	  Ascend 310 (Hi1910) SoC, as found on Atlas 200 based boards.
+	  Select this option if the root filesystem lives on the SD card.
+
 config MMC_DW_K3
 	tristate "K3 specific extensions for Synopsys DW Memory Card Interface"
 	depends on MMC_DW
diff --git a/drivers/mmc/host/Makefile b/drivers/mmc/host/Makefile
index 5057fea8a..bf2b61bc7 100644
--- a/drivers/mmc/host/Makefile
+++ b/drivers/mmc/host/Makefile
@@ -54,6 +54,7 @@ obj-$(CONFIG_MMC_DW_EXYNOS)	+= dw_mmc-exynos.o
 obj-$(CONFIG_MMC_DW_HI3798CV200) += dw_mmc-hi3798cv200.o
 obj-$(CONFIG_MMC_DW_HI3798MV200) += dw_mmc-hi3798mv200.o
 obj-$(CONFIG_MMC_DW_K3)		+= dw_mmc-k3.o
+obj-$(CONFIG_MMC_DW_ASCEND310)	+= dw_mmc-ascend310.o
 obj-$(CONFIG_MMC_DW_PCI)	+= dw_mmc-pci.o
 obj-$(CONFIG_MMC_DW_ROCKCHIP)	+= dw_mmc-rockchip.o
 obj-$(CONFIG_MMC_DW_STARFIVE)	+= dw_mmc-starfive.o
diff --git a/drivers/mmc/host/dw_mmc-ascend310.c b/drivers/mmc/host/dw_mmc-ascend310.c
new file mode 100644
index 000000000..8466d8ea1
--- /dev/null
+++ b/drivers/mmc/host/dw_mmc-ascend310.c
@@ -0,0 +1,405 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HiSilicon Ascend 310 (Hi1910) specific extensions for the Synopsys DW-MSHC.
+ *
+ * The controller is the Kirin flavour of the DW-MSHC (see dw_mmc-k3.c): the
+ * card clock is generated by a fixed /8 divider behind the GPIO register and
+ * sample/drive phases live in UHS_REG_EXT/ENABLE_SHIFT.  What differs is the
+ * glue around it: there is no clock/reset framework provider, so the source
+ * clock (3.2 MHz or PLL5 / n), the clock gate and the reset are programmed
+ * directly in the peripheral sub-control block, and the 1.8 V pad bias is
+ * selected in the system controller.  Register layout and timing values come
+ * from the vendor dw_mmc_hi3xxx.c driver shipped with the Ascend310 21.0.4
+ * kernel source.
+ *
+ * reg[0]: controller, reg[1]: peri sub-control, reg[2]: system controller.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/mmc/host.h>
+#include <linux/mmc/mmc.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include "dw_mmc.h"
+#include "dw_mmc-pltfm.h"
+
+/* peri sub-control */
+#define PERI_EMMC_ICG_EN		0x5c0
+#define PERI_EMMC_ICG_DIS		0x5c4
+#define PERI_EMMC_RST_REQ		0xcb0
+#define PERI_EMMC_RST_DREQ		0xcb4
+#define PERI_EMMC_RST_BIT		BIT(0)
+#define PERI_EMMC_CLK_SEL		0x3500
+#define PERI_EMMC_CLK_SEL_PLL5		BIT(0)
+
+/* system controller */
+#define SC_PLL_PROF_CFG0		0x3688
+#define SC_PLL5_EMMC_DIV		GENMASK(27, 24)
+#define SC_BIAS_CTRL			0x3780
+#define SC_BIAS_SEL18			GENMASK(1, 0)
+
+#define SLOW_CLK_RATE			3200000UL
+#define PLL5_CLK_RATE			1600000000UL
+#define PLL5_DIV_MAX			16
+
+#define SDCARD_RD_THRESHOLD		512
+
+#define GENCLK_DIV			7
+
+#define GPIO_CLK_ENABLE			BIT(16)
+#define GPIO_CLK_DIV_MASK		GENMASK(11, 8)
+#define GPIO_USE_SAMPLE_DLY_MASK	GENMASK(13, 13)
+#define UHS_REG_EXT_SAMPLE_PHASE_MASK	GENMASK(20, 16)
+#define UHS_REG_EXT_SAMPLE_DRVPHASE_MASK GENMASK(25, 21)
+#define UHS_REG_EXT_SAMPLE_DLY_MASK	GENMASK(30, 26)
+
+#define NUM_PHASES			40
+
+#define ENABLE_SHIFT_MIN_SMPL		4
+#define ENABLE_SHIFT_MAX_SMPL		12
+#define USE_DLY_MIN_SMPL		11
+#define USE_DLY_MAX_SMPL		14
+
+struct ascend310_priv {
+	void __iomem *peri;
+	void __iomem *sysctrl;
+	unsigned int cur_clock;
+	int cur_timing;
+};
+
+struct hs_timing {
+	u32 drv_phase;
+	u32 smpl_dly;
+	u32 smpl_phase_max;
+	u32 smpl_phase_min;
+};
+
+/* SD row of hs_timing_config_kirin970, which the vendor driver uses here */
+static const struct hs_timing hs_timing_cfg[] = {
+	[MMC_TIMING_LEGACY]	= {7, 0, 15, 15},
+	[MMC_TIMING_MMC_HS]	= {6, 0,  1,  1},
+	[MMC_TIMING_SD_HS]	= {6, 0,  4,  4},
+	[MMC_TIMING_UHS_SDR12]	= {6, 0, 15, 15},
+	[MMC_TIMING_UHS_SDR25]	= {6, 0,  2,  2},
+	[MMC_TIMING_UHS_SDR50]	= {5, 0, 12,  0},
+	[MMC_TIMING_UHS_SDR104]	= {5, 4, 15,  0},
+};
+
+static void dw_mci_ascend310_set_timing(struct dw_mci *host, int timing,
+					 int smpl_phase)
+{
+	const struct hs_timing *cfg;
+	u32 use_smpl_dly = 0;
+	u32 enable_shift = 0;
+	u32 reg_value;
+
+	if (timing < 0 || timing >= ARRAY_SIZE(hs_timing_cfg))
+		timing = MMC_TIMING_LEGACY;
+	cfg = &hs_timing_cfg[timing];
+
+	if (smpl_phase == -1)
+		smpl_phase = (cfg->smpl_phase_max + cfg->smpl_phase_min) / 2;
+
+	switch (timing) {
+	case MMC_TIMING_UHS_SDR104:
+		if (smpl_phase >= USE_DLY_MIN_SMPL &&
+		    smpl_phase <= USE_DLY_MAX_SMPL)
+			use_smpl_dly = 1;
+		fallthrough;
+	case MMC_TIMING_UHS_SDR50:
+		if (smpl_phase >= ENABLE_SHIFT_MIN_SMPL &&
+		    smpl_phase <= ENABLE_SHIFT_MAX_SMPL)
+			enable_shift = 1;
+		break;
+	}
+
+	mci_writel(host, GPIO, 0x0);
+	usleep_range(5, 10);
+
+	reg_value = FIELD_PREP(UHS_REG_EXT_SAMPLE_PHASE_MASK, smpl_phase) |
+		    FIELD_PREP(UHS_REG_EXT_SAMPLE_DLY_MASK, cfg->smpl_dly) |
+		    FIELD_PREP(UHS_REG_EXT_SAMPLE_DRVPHASE_MASK, cfg->drv_phase);
+	mci_writel(host, UHS_REG_EXT, reg_value);
+
+	mci_writel(host, ENABLE_SHIFT, enable_shift);
+
+	reg_value = FIELD_PREP(GPIO_CLK_DIV_MASK, GENCLK_DIV) |
+		    FIELD_PREP(GPIO_USE_SAMPLE_DLY_MASK, use_smpl_dly);
+	mci_writel(host, GPIO, reg_value | GPIO_CLK_ENABLE);
+
+	/* wait for the new timing to settle */
+	usleep_range(1000, 2000);
+}
+
+/* Pick the source clock that gives @clock after the fixed /8 divider */
+static unsigned long dw_mci_ascend310_src_rate(unsigned int clock)
+{
+	unsigned long wanted = (unsigned long)clock * (GENCLK_DIV + 1);
+	unsigned long div;
+
+	if (wanted <= SLOW_CLK_RATE)
+		return SLOW_CLK_RATE;
+
+	div = clamp(DIV_ROUND_UP(PLL5_CLK_RATE, wanted), 1UL,
+		    (unsigned long)PLL5_DIV_MAX);
+	return PLL5_CLK_RATE / div;
+}
+
+static void dw_mci_ascend310_set_src(struct dw_mci *host, unsigned long rate)
+{
+	struct ascend310_priv *priv = host->priv;
+	u32 sel, cfg;
+
+	writel(1, priv->peri + PERI_EMMC_ICG_DIS);
+
+	sel = readl(priv->peri + PERI_EMMC_CLK_SEL);
+	if (rate == SLOW_CLK_RATE) {
+		sel &= ~PERI_EMMC_CLK_SEL_PLL5;
+	} else {
+		cfg = readl(priv->sysctrl + SC_PLL_PROF_CFG0);
+		cfg &= ~SC_PLL5_EMMC_DIV;
+		cfg |= FIELD_PREP(SC_PLL5_EMMC_DIV, PLL5_CLK_RATE / rate - 1);
+		writel(cfg, priv->sysctrl + SC_PLL_PROF_CFG0);
+		sel |= PERI_EMMC_CLK_SEL_PLL5;
+	}
+	writel(sel, priv->peri + PERI_EMMC_CLK_SEL);
+
+	writel(1, priv->peri + PERI_EMMC_ICG_EN);
+}
+
+static int dw_mci_ascend310_parse_dt(struct dw_mci *host)
+{
+	struct platform_device *pdev = to_platform_device(host->dev);
+	struct ascend310_priv *priv;
+	struct resource *res;
+
+	priv = devm_kzalloc(host->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	/* these blocks are shared with other users, so map without claiming */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res)
+		return -EINVAL;
+	priv->peri = devm_ioremap(host->dev, res->start, resource_size(res));
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 2);
+	if (!res)
+		return -EINVAL;
+	priv->sysctrl = devm_ioremap(host->dev, res->start, resource_size(res));
+
+	if (!priv->peri || !priv->sysctrl)
+		return -ENOMEM;
+
+	priv->cur_timing = -1;
+	host->priv = priv;
+	return 0;
+}
+
+static int dw_mci_ascend310_init(struct dw_mci *host)
+{
+	struct ascend310_priv *priv = host->priv;
+
+	/* full controller reset: the previous owner may have left it in UHS */
+	writel(1, priv->peri + PERI_EMMC_ICG_DIS);
+	writel(PERI_EMMC_RST_BIT, priv->peri + PERI_EMMC_RST_REQ);
+	usleep_range(10, 20);
+	dw_mci_ascend310_set_src(host, SLOW_CLK_RATE);
+	writel(PERI_EMMC_RST_BIT, priv->peri + PERI_EMMC_RST_DREQ);
+	usleep_range(10, 20);
+
+	mci_writel(host, CDTHRCTL, SDMMC_SET_THLD(SDCARD_RD_THRESHOLD,
+		   SDMMC_CARD_RD_THR_EN));
+
+	dw_mci_ascend310_set_timing(host, MMC_TIMING_LEGACY, -1);
+	host->bus_hz = SLOW_CLK_RATE / (GENCLK_DIV + 1);
+
+	return 0;
+}
+
+static void dw_mci_ascend310_set_ios(struct dw_mci *host, struct mmc_ios *ios)
+{
+	struct ascend310_priv *priv = host->priv;
+	unsigned long rate;
+
+	if (!ios->clock ||
+	    (ios->clock == priv->cur_clock && ios->timing == priv->cur_timing))
+		return;
+
+	rate = dw_mci_ascend310_src_rate(ios->clock);
+	dw_mci_ascend310_set_src(host, rate);
+	dw_mci_ascend310_set_timing(host, ios->timing, -1);
+
+	host->bus_hz = rate / (GENCLK_DIV + 1);
+	host->current_speed = 0;
+	priv->cur_clock = ios->clock;
+	priv->cur_timing = ios->timing;
+}
+
+static int dw_mci_get_best_clksmpl(unsigned int sample_flag)
+{
+	int i;
+	int interval;
+	unsigned int v;
+	unsigned int len;
+	unsigned int range_start = 0;
+	unsigned int range_length = 0;
+	unsigned int middle_range;
+
+	if (!sample_flag)
+		return -EIO;
+
+	if (~sample_flag == 0)
+		return 0;
+
+	i = ffs(sample_flag) - 1;
+
+	/* a clock cycle is split in 32 phases; pick the middle of the widest pass window */
+	while (i < 32) {
+		v = ror32(sample_flag, i);
+		len = ffs(~v) - 1;
+
+		if (len > range_length) {
+			range_length = len;
+			range_start = i;
+		}
+
+		interval = ffs(v >> len) - 1;
+		if (interval < 0)
+			break;
+
+		i += len + interval;
+	}
+
+	middle_range = range_start + range_length / 2;
+	if (middle_range >= 32)
+		middle_range %= 32;
+
+	return middle_range;
+}
+
+static int dw_mci_ascend310_execute_tuning(struct dw_mci_slot *slot, u32 opcode)
+{
+	struct dw_mci *host = slot->host;
+	struct mmc_host *mmc = slot->mmc;
+	u32 tuning_sample_flag = 0;
+	int smpl_phase = 0;
+	int best_clksmpl;
+	int i;
+
+	for (i = 0; i < NUM_PHASES; ++i, ++smpl_phase) {
+		smpl_phase %= 32;
+
+		mci_writel(host, TMOUT, ~0);
+		dw_mci_ascend310_set_timing(host, mmc->ios.timing, smpl_phase);
+
+		if (!mmc_send_tuning(mmc, opcode, NULL))
+			tuning_sample_flag |= (1 << smpl_phase);
+		else
+			tuning_sample_flag &= ~(1 << smpl_phase);
+	}
+
+	best_clksmpl = dw_mci_get_best_clksmpl(tuning_sample_flag);
+	if (best_clksmpl < 0) {
+		dev_err(host->dev, "All phases bad!\n");
+		return -EIO;
+	}
+
+	dw_mci_ascend310_set_timing(host, mmc->ios.timing, best_clksmpl);
+
+	dev_info(host->dev, "tuning ok best_clksmpl %u tuning_sample_flag %x\n",
+		 best_clksmpl, tuning_sample_flag);
+	return 0;
+}
+
+static void dw_mci_ascend310_set_sel18(struct dw_mci *host, bool set)
+{
+	struct ascend310_priv *priv = host->priv;
+	u32 reg;
+
+	reg = readl(priv->sysctrl + SC_BIAS_CTRL);
+	if (set)
+		reg |= SC_BIAS_SEL18;
+	else
+		reg &= ~SC_BIAS_SEL18;
+	writel(reg, priv->sysctrl + SC_BIAS_CTRL);
+}
+
+static int dw_mci_ascend310_switch_voltage(struct mmc_host *mmc,
+					   struct mmc_ios *ios)
+{
+	struct dw_mci_slot *slot = mmc_priv(mmc);
+	struct dw_mci *host = slot->host;
+	int ret = 0;
+
+	if (ios->signal_voltage == MMC_SIGNAL_VOLTAGE_330) {
+		dw_mci_ascend310_set_sel18(host, false);
+		usleep_range(5000, 5500);
+		if (!IS_ERR(mmc->supply.vqmmc))
+			ret = mmc_regulator_set_vqmmc(mmc, ios);
+	} else if (ios->signal_voltage == MMC_SIGNAL_VOLTAGE_180) {
+		if (!IS_ERR(mmc->supply.vqmmc))
+			ret = mmc_regulator_set_vqmmc(mmc, ios);
+		/* the PMU needs time to bring LDO9 down before the pads follow */
+		usleep_range(55000, 55500);
+		dw_mci_ascend310_set_sel18(host, true);
+	} else {
+		return -EINVAL;
+	}
+
+	if (ret < 0) {
+		dev_err(host->dev, "Regulator set error %d\n", ret);
+		return ret;
+	}
+
+	usleep_range(5000, 5500);
+	return 0;
+}
+
+static const struct dw_mci_drv_data ascend310_drv_data = {
+	.init			= dw_mci_ascend310_init,
+	.set_ios		= dw_mci_ascend310_set_ios,
+	.parse_dt		= dw_mci_ascend310_parse_dt,
+	.execute_tuning		= dw_mci_ascend310_execute_tuning,
+	.switch_voltage		= dw_mci_ascend310_switch_voltage,
+};
+
+static const struct of_device_id dw_mci_ascend310_match[] = {
+	{ .compatible = "hisilicon,ascend310-dw-mshc", .data = &ascend310_drv_data },
+	{},
+};
+MODULE_DEVICE_TABLE(of, dw_mci_ascend310_match);
+
+static int dw_mci_ascend310_probe(struct platform_device *pdev)
+{
+	return dw_mci_pltfm_register(pdev, &ascend310_drv_data);
+}
+
+static const struct dev_pm_ops dw_mci_ascend310_dev_pm_ops = {
+	SYSTEM_SLEEP_PM_OPS(pm_runtime_force_suspend, pm_runtime_force_resume)
+	RUNTIME_PM_OPS(dw_mci_runtime_suspend, dw_mci_runtime_resume, NULL)
+};
+
+static struct platform_driver dw_mci_ascend310_pltfm_driver = {
+	.probe		= dw_mci_ascend310_probe,
+	.remove		= dw_mci_pltfm_remove,
+	.driver		= {
+		.name		= "dwmmc_ascend310",
+		.probe_type	= PROBE_PREFER_ASYNCHRONOUS,
+		.of_match_table	= dw_mci_ascend310_match,
+		.pm		= pm_ptr(&dw_mci_ascend310_dev_pm_ops),
+	},
+};
+
+module_platform_driver(dw_mci_ascend310_pltfm_driver);
+
+MODULE_DESCRIPTION("HiSilicon Ascend 310 DW-MSHC Driver Extension");
+MODULE_LICENSE("GPL");
+MODULE_ALIAS("platform:dwmmc_ascend310");
-- 
