+}
+
+static inline void higmac_port_enable(struct higmac_netdev_local *ld)
+{
+    writel(BITS_TX_EN | BITS_RX_EN, ld->gmac_iobase + PORT_EN);
+}
+
+static inline void higmac_port_disable(struct higmac_netdev_local *ld)
