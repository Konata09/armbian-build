+
+    if (priv->has_rxhash_cap)
+        val |= BIT_RXHASH_CAP;
+    if (priv->has_rss_cap)
+        val |= BIT_RSS_CAP;
+    writel(val, priv->gmac_iobase + HW_CAP_EN);
