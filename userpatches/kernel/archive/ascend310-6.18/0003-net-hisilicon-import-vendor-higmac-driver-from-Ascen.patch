+static inline void higmac_hw_desc_enable(struct higmac_netdev_local *ld)
+{
+    writel(0xF, ld->gmac_iobase + DESC_WR_RD_ENA);
+}
+
+static inline void higmac_hw_desc_disable(struct higmac_netdev_local *ld)
+{
