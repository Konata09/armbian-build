+struct higmac_sample *sample_priv = NULL;
+
+static struct {
+    const char str[SAMPLE_NAME_MAX];
+} higmac_sample_names[] = {
+    { "bandwidth" },
+
+    { "rxPacket/s" },
+    { "rxByte/s" },
+    { "rxPackets" },
+    { "rxBytes" },
+    { "rxErrors" },
+    { "rxDropped" },
+
+    { "txPacket/s" },
