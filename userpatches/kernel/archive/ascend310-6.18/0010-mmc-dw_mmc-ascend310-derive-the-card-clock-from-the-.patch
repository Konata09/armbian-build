From e980443504fcfae1e470f3ad2e79f2e095480cf8 Mon Sep 17 00:00:00 2001
From: "Claude (for konata09)" <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 09:35:17 +0800
Subject: [PATCH 10/10] mmc: dw_mmc-ascend310: derive the card clock from the
 real PLL5 rate

The glue assumed that PLL5 runs at the 1.6 GHz the boot firmware sets,
and always divided by 8 in the GPIO register. PLL5 is the A55 cluster
PLL: with the CPUs at 2.0 GHz the SDR104 clock ended up at 250 MHz, and
the card kept failing and re-tuning.

Take PLL5 from the device tree (an optional "pll5" clock, 1.6 GHz if it
is absent), hold its rate, and pick the PLL5 and GPIO dividers that give
the card clock closest to the requested rate, preferring the vendor /8.
A GPIO divider other than /8 moves the sample delay, the phase range and
the shift and delay windows the way the vendor driver does for its /10
settings, and tuning scans the 2 * (div + 1) phases of one card cycle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/mmc/host/dw_mmc-ascend310.c | 200 +++++++++++++++++++---------
 1 file changed, 135 insertions(+), 65 deletions(-)

diff --git a/drivers/mmc/host/dw_mmc-ascend310.c b/drivers/mmc/host/dw_mmc-ascend310.c
index 8466d8ea1..ec76817bc 100644
--- a/drivers/mmc/host/dw_mmc-ascend310.c
+++ b/drivers/mmc/host/dw_mmc-ascend310.c
@@ -3,7 +3,7 @@
  * HiSilicon Ascend 310 (Hi1910) specific extensions for the Synopsys DW-MSHC.
  *
  * The controller is the Kirin flavour of the DW-MSHC (see dw_mmc-k3.c): the
- * card clock is generated by a fixed /8 divider behind the GPIO register and
+ * card clock is generated by a divider behind the GPIO register and
  * sample/drive phases live in UHS_REG_EXT/ENABLE_SHIFT.  What differs is the
  * glue around it: there is no clock/reset framework provider, so the source
  * clock (3.2 MHz or PLL5 / n), the clock gate and the reset are programmed
@@ -12,11 +12,17 @@
  * from the vendor dw_mmc_hi3xxx.c driver shipped with the Ascend310 21.0.4
  * kernel source.
  *
+ * PLL5 is the A55 cluster PLL.  The vendor timings assume it runs at 1.6 GHz
+ * and divide by 8 in the GPIO register; when the CPUs run faster, a larger
+ * GPIO divider keeps the card clock at the requested rate, with the sample
+ * timing shifted the way the vendor driver does for its /10 settings.
+ *
  * reg[0]: controller, reg[1]: peri sub-control, reg[2]: system controller.
  */
 
 #include <linux/bitfield.h>
 #include <linux/bitops.h>
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/mmc/host.h>
@@ -46,12 +52,15 @@
 #define SC_BIAS_SEL18			GENMASK(1, 0)
 
 #define SLOW_CLK_RATE			3200000UL
-#define PLL5_CLK_RATE			1600000000UL
+/* what the boot firmware sets when the device tree gives no PLL5 clock */
+#define PLL5_DEFAULT_RATE		1600000000UL
 #define PLL5_DIV_MAX			16
 
 #define SDCARD_RD_THRESHOLD		512
 
+/* the GPIO divider (divides by n + 1) the vendor timings are tuned for */
 #define GENCLK_DIV			7
+#define GENCLK_DIV_MAX			15
 
 #define GPIO_CLK_ENABLE			BIT(16)
 #define GPIO_CLK_DIV_MASK		GENMASK(11, 8)
@@ -60,8 +69,6 @@
 #define UHS_REG_EXT_SAMPLE_DRVPHASE_MASK GENMASK(25, 21)
 #define UHS_REG_EXT_SAMPLE_DLY_MASK	GENMASK(30, 26)
 
-#define NUM_PHASES			40
-
 #define ENABLE_SHIFT_MIN_SMPL		4
 #define ENABLE_SHIFT_MAX_SMPL		12
 #define USE_DLY_MIN_SMPL		11
@@ -70,8 +77,12 @@
 struct ascend310_priv {
 	void __iomem *peri;
 	void __iomem *sysctrl;
+	unsigned long pll5_rate;
 	unsigned int cur_clock;
 	int cur_timing;
+	/* card clock input = PLL5 / pll5_div / (genclk_div + 1); pll5_div 0: slow clock */
+	unsigned int pll5_div;
+	unsigned int genclk_div;
 };
 
 struct hs_timing {
@@ -92,30 +103,48 @@ static const struct hs_timing hs_timing_cfg[] = {
 	[MMC_TIMING_UHS_SDR104]	= {5, 4, 15,  0},
 };
 
+/* the legacy timing always runs with the vendor divider */
+static unsigned int dw_mci_ascend310_genclk_div(struct dw_mci *host, int timing)
+{
+	struct ascend310_priv *priv = host->priv;
+
+	return timing == MMC_TIMING_LEGACY ? GENCLK_DIV : priv->genclk_div;
+}
+
 static void dw_mci_ascend310_set_timing(struct dw_mci *host, int timing,
 					 int smpl_phase)
 {
 	const struct hs_timing *cfg;
+	unsigned int genclk_div;
 	u32 use_smpl_dly = 0;
 	u32 enable_shift = 0;
 	u32 reg_value;
+	int d;
 
 	if (timing < 0 || timing >= ARRAY_SIZE(hs_timing_cfg))
 		timing = MMC_TIMING_LEGACY;
 	cfg = &hs_timing_cfg[timing];
 
+	/*
+	 * A card clock cycle has 2 * (genclk_div + 1) sample phases. With a
+	 * larger divider the vendor driver moves the sample delay, the phase
+	 * range and the shift/delay windows by d, 2d and d (dw_mci_hs_set_timing).
+	 */
+	genclk_div = dw_mci_ascend310_genclk_div(host, timing);
+	d = genclk_div - GENCLK_DIV;
+
 	if (smpl_phase == -1)
-		smpl_phase = (cfg->smpl_phase_max + cfg->smpl_phase_min) / 2;
+		smpl_phase = (cfg->smpl_phase_max + 2 * d + cfg->smpl_phase_min) / 2;
 
 	switch (timing) {
 	case MMC_TIMING_UHS_SDR104:
-		if (smpl_phase >= USE_DLY_MIN_SMPL &&
-		    smpl_phase <= USE_DLY_MAX_SMPL)
+		if (smpl_phase >= USE_DLY_MIN_SMPL + 2 * d &&
+		    smpl_phase <= USE_DLY_MAX_SMPL + 2 * d)
 			use_smpl_dly = 1;
 		fallthrough;
 	case MMC_TIMING_UHS_SDR50:
-		if (smpl_phase >= ENABLE_SHIFT_MIN_SMPL &&
-		    smpl_phase <= ENABLE_SHIFT_MAX_SMPL)
+		if (smpl_phase >= ENABLE_SHIFT_MIN_SMPL + d &&
+		    smpl_phase <= ENABLE_SHIFT_MAX_SMPL + d)
 			enable_shift = 1;
 		break;
 	}
@@ -124,13 +153,13 @@ static void dw_mci_ascend310_set_timing(struct dw_mci *host, int timing,
 	usleep_range(5, 10);
 
 	reg_value = FIELD_PREP(UHS_REG_EXT_SAMPLE_PHASE_MASK, smpl_phase) |
-		    FIELD_PREP(UHS_REG_EXT_SAMPLE_DLY_MASK, cfg->smpl_dly) |
+		    FIELD_PREP(UHS_REG_EXT_SAMPLE_DLY_MASK, cfg->smpl_dly + d) |
 		    FIELD_PREP(UHS_REG_EXT_SAMPLE_DRVPHASE_MASK, cfg->drv_phase);
 	mci_writel(host, UHS_REG_EXT, reg_value);
 
 	mci_writel(host, ENABLE_SHIFT, enable_shift);
 
-	reg_value = FIELD_PREP(GPIO_CLK_DIV_MASK, GENCLK_DIV) |
+	reg_value = FIELD_PREP(GPIO_CLK_DIV_MASK, genclk_div) |
 		    FIELD_PREP(GPIO_USE_SAMPLE_DLY_MASK, use_smpl_dly);
 	mci_writel(host, GPIO, reg_value | GPIO_CLK_ENABLE);
 
@@ -138,21 +167,50 @@ static void dw_mci_ascend310_set_timing(struct dw_mci *host, int timing,
 	usleep_range(1000, 2000);
 }
 
-/* Pick the source clock that gives @clock after the fixed /8 divider */
-static unsigned long dw_mci_ascend310_src_rate(unsigned int clock)
+static bool dw_mci_ascend310_better(unsigned long rate, unsigned long best,
+				    unsigned int clock)
 {
-	unsigned long wanted = (unsigned long)clock * (GENCLK_DIV + 1);
-	unsigned long div;
+	if (!best)
+		return true;
+	/* the controller's own divider brings a faster clock down */
+	if (rate > clock)
+		return best > clock && rate < best;
+	return best > clock || rate > best;
+}
 
-	if (wanted <= SLOW_CLK_RATE)
-		return SLOW_CLK_RATE;
+/*
+ * Pick the dividers that give the card clock input closest to @clock without
+ * exceeding it, preferring the vendor GPIO divider. Returns that rate.
+ */
+static unsigned long dw_mci_ascend310_pick_src(struct dw_mci *host,
+					       unsigned int clock, int timing)
+{
+	struct ascend310_priv *priv = host->priv;
+	unsigned int genclk_div, genclk_max, pll5_div;
+	unsigned long rate, best = 0;
 
-	div = clamp(DIV_ROUND_UP(PLL5_CLK_RATE, wanted), 1UL,
-		    (unsigned long)PLL5_DIV_MAX);
-	return PLL5_CLK_RATE / div;
+	if ((unsigned long)clock * (GENCLK_DIV + 1) <= SLOW_CLK_RATE) {
+		priv->pll5_div = 0;
+		priv->genclk_div = GENCLK_DIV;
+		return SLOW_CLK_RATE / (GENCLK_DIV + 1);
+	}
+
+	genclk_max = timing == MMC_TIMING_LEGACY ? GENCLK_DIV : GENCLK_DIV_MAX;
+	for (genclk_div = GENCLK_DIV; genclk_div <= genclk_max; genclk_div++) {
+		pll5_div = DIV_ROUND_UP(priv->pll5_rate,
+					(unsigned long)clock * (genclk_div + 1));
+		pll5_div = clamp(pll5_div, 1U, (unsigned int)PLL5_DIV_MAX);
+		rate = priv->pll5_rate / pll5_div / (genclk_div + 1);
+		if (dw_mci_ascend310_better(rate, best, clock)) {
+			best = rate;
+			priv->pll5_div = pll5_div;
+			priv->genclk_div = genclk_div;
+		}
+	}
+	return best;
 }
 
-static void dw_mci_ascend310_set_src(struct dw_mci *host, unsigned long rate)
+static void dw_mci_ascend310_set_src(struct dw_mci *host)
 {
 	struct ascend310_priv *priv = host->priv;
 	u32 sel, cfg;
@@ -160,12 +218,12 @@ static void dw_mci_ascend310_set_src(struct dw_mci *host, unsigned long rate)
 	writel(1, priv->peri + PERI_EMMC_ICG_DIS);
 
 	sel = readl(priv->peri + PERI_EMMC_CLK_SEL);
-	if (rate == SLOW_CLK_RATE) {
+	if (!priv->pll5_div) {
 		sel &= ~PERI_EMMC_CLK_SEL_PLL5;
 	} else {
 		cfg = readl(priv->sysctrl + SC_PLL_PROF_CFG0);
 		cfg &= ~SC_PLL5_EMMC_DIV;
-		cfg |= FIELD_PREP(SC_PLL5_EMMC_DIV, PLL5_CLK_RATE / rate - 1);
+		cfg |= FIELD_PREP(SC_PLL5_EMMC_DIV, priv->pll5_div - 1);
 		writel(cfg, priv->sysctrl + SC_PLL_PROF_CFG0);
 		sel |= PERI_EMMC_CLK_SEL_PLL5;
 	}
@@ -179,11 +237,28 @@ static int dw_mci_ascend310_parse_dt(struct dw_mci *host)
 	struct platform_device *pdev = to_platform_device(host->dev);
 	struct ascend310_priv *priv;
 	struct resource *res;
+	struct clk *pll5;
+	int ret;
 
 	priv = devm_kzalloc(host->dev, sizeof(*priv), GFP_KERNEL);
 	if (!priv)
 		return -ENOMEM;
 
+	pll5 = devm_clk_get_optional(host->dev, "pll5");
+	if (IS_ERR(pll5))
+		return dev_err_probe(host->dev, PTR_ERR(pll5), "failed to get PLL5\n");
+	if (pll5) {
+		/* the card clock is derived from it: keep its rate fixed */
+		ret = devm_clk_rate_exclusive_get(host->dev, pll5);
+		if (ret)
+			return ret;
+		priv->pll5_rate = clk_get_rate(pll5);
+	} else {
+		priv->pll5_rate = PLL5_DEFAULT_RATE;
+	}
+	if (!priv->pll5_rate)
+		return -EINVAL;
+
 	/* these blocks are shared with other users, so map without claiming */
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
 	if (!res)
@@ -211,7 +286,9 @@ static int dw_mci_ascend310_init(struct dw_mci *host)
 	writel(1, priv->peri + PERI_EMMC_ICG_DIS);
 	writel(PERI_EMMC_RST_BIT, priv->peri + PERI_EMMC_RST_REQ);
 	usleep_range(10, 20);
-	dw_mci_ascend310_set_src(host, SLOW_CLK_RATE);
+	priv->pll5_div = 0;
+	priv->genclk_div = GENCLK_DIV;
+	dw_mci_ascend310_set_src(host);
 	writel(PERI_EMMC_RST_BIT, priv->peri + PERI_EMMC_RST_DREQ);
 	usleep_range(10, 20);
 
@@ -233,80 +310,70 @@ static void dw_mci_ascend310_set_ios(struct dw_mci *host, struct mmc_ios *ios)
 	    (ios->clock == priv->cur_clock && ios->timing == priv->cur_timing))
 		return;
 
-	rate = dw_mci_ascend310_src_rate(ios->clock);
-	dw_mci_ascend310_set_src(host, rate);
+	rate = dw_mci_ascend310_pick_src(host, ios->clock, ios->timing);
+	dw_mci_ascend310_set_src(host);
 	dw_mci_ascend310_set_timing(host, ios->timing, -1);
 
-	host->bus_hz = rate / (GENCLK_DIV + 1);
+	host->bus_hz = rate;
 	host->current_speed = 0;
 	priv->cur_clock = ios->clock;
 	priv->cur_timing = ios->timing;
 }
 
-static int dw_mci_get_best_clksmpl(unsigned int sample_flag)
+/* middle of the widest window of passing phases; the phases wrap around */
+static int dw_mci_get_best_clksmpl(u32 sample_flag, unsigned int nphases)
 {
-	int i;
-	int interval;
-	unsigned int v;
-	unsigned int len;
-	unsigned int range_start = 0;
-	unsigned int range_length = 0;
-	unsigned int middle_range;
+	u32 all = GENMASK(nphases - 1, 0);
+	unsigned int best_start = 0, best_len = 0;
+	unsigned int start, len;
 
+	sample_flag &= all;
 	if (!sample_flag)
 		return -EIO;
 
-	if (~sample_flag == 0)
+	if (sample_flag == all)
 		return 0;
 
-	i = ffs(sample_flag) - 1;
+	for (start = 0; start < nphases; start++) {
+		/* a window starts at a passing phase after a failing one */
+		if (!(sample_flag & BIT(start)) ||
+		    sample_flag & BIT((start + nphases - 1) % nphases))
+			continue;
 
-	/* a clock cycle is split in 32 phases; pick the middle of the widest pass window */
-	while (i < 32) {
-		v = ror32(sample_flag, i);
-		len = ffs(~v) - 1;
+		for (len = 0; sample_flag & BIT((start + len) % nphases); len++)
+			;
 
-		if (len > range_length) {
-			range_length = len;
-			range_start = i;
+		if (len > best_len) {
+			best_len = len;
+			best_start = start;
 		}
-
-		interval = ffs(v >> len) - 1;
-		if (interval < 0)
-			break;
-
-		i += len + interval;
 	}
 
-	middle_range = range_start + range_length / 2;
-	if (middle_range >= 32)
-		middle_range %= 32;
-
-	return middle_range;
+	return (best_start + best_len / 2) % nphases;
 }
 
 static int dw_mci_ascend310_execute_tuning(struct dw_mci_slot *slot, u32 opcode)
 {
 	struct dw_mci *host = slot->host;
+	struct ascend310_priv *priv = host->priv;
 	struct mmc_host *mmc = slot->mmc;
 	u32 tuning_sample_flag = 0;
-	int smpl_phase = 0;
+	unsigned int smpl_phase;
+	unsigned int nphases;
 	int best_clksmpl;
-	int i;
 
-	for (i = 0; i < NUM_PHASES; ++i, ++smpl_phase) {
-		smpl_phase %= 32;
+	/* two sample phases per step of the GPIO divider */
+	nphases = 2 * (dw_mci_ascend310_genclk_div(host, mmc->ios.timing) + 1);
 
+	for (smpl_phase = 0; smpl_phase < nphases; smpl_phase++) {
 		mci_writel(host, TMOUT, ~0);
 		dw_mci_ascend310_set_timing(host, mmc->ios.timing, smpl_phase);
 
 		if (!mmc_send_tuning(mmc, opcode, NULL))
-			tuning_sample_flag |= (1 << smpl_phase);
-		else
-			tuning_sample_flag &= ~(1 << smpl_phase);
+			tuning_sample_flag |= BIT(smpl_phase);
 	}
 
-	best_clksmpl = dw_mci_get_best_clksmpl(tuning_sample_flag);
+	best_clksmpl = dw_mci_get_best_clksmpl(tuning_sample_flag, nphases);
 	if (best_clksmpl < 0) {
 		dev_err(host->dev, "All phases bad!\n");
 		return -EIO;
@@ -314,8 +381,11 @@ static int dw_mci_ascend310_execute_tuning(struct dw_mci_slot *slot, u32 opcode)
 
 	dw_mci_ascend310_set_timing(host, mmc->ios.timing, best_clksmpl);
 
-	dev_info(host->dev, "tuning ok best_clksmpl %u tuning_sample_flag %x\n",
-		 best_clksmpl, tuning_sample_flag);
+	dev_info(host->dev,
+		 "tuning ok at %u Hz (PLL5 %lu / %u / %u): best_clksmpl %d of %u, tuning_sample_flag %x\n",
+		 host->bus_hz, priv->pll5_rate, priv->pll5_div,
+		 priv->genclk_div + 1, best_clksmpl, nphases,
+		 tuning_sample_flag);
 	return 0;
 }
 
