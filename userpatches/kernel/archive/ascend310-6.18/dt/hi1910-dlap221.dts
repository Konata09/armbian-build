		};

		ddrc-os@130800000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x00>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0x30800000 0x00 0xc000>;
			interrupts = <0x00 0x17a 0x04>;
		};

		ddrc-os@130820000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x01>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0x30820000 0x00 0xc000>;
			interrupts = <0x00 0x17f 0x04>;
		};

		ddrc-os@130840000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x02>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0x30840000 0x00 0xc000>;
			interrupts = <0x00 0x184 0x04>;
		};

		ddrc-os@130860000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x03>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0x30860000 0x00 0xc000>;
			interrupts = <0x00 0x189 0x04>;
		};

		ddrc-os@10cd20000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x04>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0xcd20000 0x00 0xc000>;
			interrupts = <0x00 0x6a 0x01>;
		};

		ddrc-os@10cd40000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x05>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0xcd40000 0x00 0xc000>;
			interrupts = <0x00 0x6f 0x04>;
		};

		ddrc-os@10cd60000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x06>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0xcd60000 0x00 0xc000>;
			interrupts = <0x00 0x74 0x04>;
		};

		ddrc-os@10cd80000 {
			compatible = "hisilicon,ddrc-pmu-mini";
			hisilicon,ch-id = <0x07>;
			hisilicon,scl-id = <0x01>;
			reg = <0x01 0xcd80000 0x00 0xc000>;
			interrupts = <0x00 0x79 0x04>;
		};

		watchdog@10c200000 {
			compatible = "arm,sbsa-gwdt";
			reg = <0x01 0xc200000 0x00 0x10000 0x01 0xc210000 0x00 0x10000>;
			interrupts = <0x00 0x8f 0x01>;
			timeout-sec = <0x0a>;
		};
	};

	memory@a00000 {
		reg = <0x00 0x00 0x00 0x80000000 0x08 0x80000000 0x01 0x80000000>;
		device_type = "memory";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		test@0x0 {
			no-map;
			reg = <0x00 0x00 0x00 0x7e00000>;
		};

		l2buff@200000000 {
			no-map;
			reg = <0x02 0x00 0x00 0x800000>;
			phandle = <0x0a>;
		};

		ramoops@9fff00000 {
			compatible = "ramoops";
			reg = <0x9 0xfff00000 0x0 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			ftrace-size = <0x0>;
			pmsg-size = <0x20000>;
		};
	};

	chosen {
		kaslr-seed = <0x00 0x00>;
		bootargs = "console=ttyAMA0,115200 earlycon=pl011,mmio32,0x10cf80000 root=/dev/mmcblk0p1 rootwait ro net.ifnames=0 cpuidle.off=1 mitigations=off rodata=noalias panic=30";
	};

	sysctrl@1100c0000 {
		compatible = "hisilicon,sysctrl";
		reg = <0x01 0x100c0000 0x00 0x10000>;
	};

	crgctrl@10c000000 {
		compatible = "hisilicon,crgctrl";
		reg = <0x01 0xc000000 0x00 0x10000>;
	};

	timer@010C830000 {
		compatible = "arm,timer_wakeup";
		rate = <0x124f800>;
		reg = <0x01 0xc830000 0x00 0x10000 0x01 0xc003134 0x00 0x10000>;
		interrupts = <0x00 0x55 0x01>;
		status = "disabled";
	};

	pmutsensor {
		status = "disabled";
		compatible = "hisilicon,pmuadc";
		tsensor-name = "murata,ncp15xh103";
		pullup-uv = <0x1b7740>;
		pullup-ohm = <0x2710>;
		pulldown-ohm = <0x00>;
	};

	firmware {

		sdei {
			compatible = "arm,sdei-1.0";
			method = "smc";
		};
	};

	hisi_sleep_gpio {
		status = "disabled";
		compatible = "hisilicon,hisi-sleep-gpio";
		is-enable = <0x00>;
		sleep-gpio = <0x11 0x06 0x00>;
	};

	os_kbox {
		status = "disabled";
		compatible = "os_kbox";
		reg = <0x00 0x71f0000 0x00 0x400000>;
	};

	osc19m2: clock-19200000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <19200000>;
		clock-output-names = "osc19m2";
	};

	/* PLL5 in the system controller: clocks the A55 cluster and the SD card */
	cpu_pll: clock-controller@1100c0040 {
		compatible = "hisilicon,ascend310-cpu-pll";
		reg = <0x01 0x100c0040 0x00 0x8>;
		clocks = <&osc19m2>;
		#clock-cells = <0>;
		/* the firmware sets 1.6 GHz; 2.0 GHz passed verified stress tests at its voltage */
		assigned-clocks = <&cpu_pll>;
		assigned-clock-rates = <2000000000>;
	};

	ascend_temp: temperature-sensor@a20000 {
		compatible = "hisilicon,ascend310-lpm3-temp";
		reg = <0x00 0xa20000 0x00 0x10>;
		#thermal-sensor-cells = <1>;
	};

	thermal-zones {
		soc-thermal {
			polling-delay = <2000>;
			polling-delay-passive = <0>;
			thermal-sensors = <&ascend_temp 0>;

			trips {
				soc-hot {
					temperature = <95000>;
					hysteresis = <2000>;
					type = "hot";
				};

				/* the SoC resets itself at 106 C: shut down cleanly first */
				soc-crit {
					temperature = <104000>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};
	};
};
