	sub_ctrl_c@10c000000 {
		compatible = "hisilicon,peri-c-subctrl", "syscon";
		reg = <0x01 0x30070000 0x00 0x10000>;
		phandle = <0x19>;
	};

	mdio@10c1a0000 {
		compatible = "hisilicon,hns-mdio";
		reg = <0x01 0x30920000 0x00 0x1000>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		/* peri sub-control: clk_en, reset_req, clk_st, reset_st (Hi1910 layout) */
		subctrl-vbase = <0x19 0x630 0xd30 0x5630 0x5d30>;
		status = "okay";

		ethernet-phy@1 {
			reg = <0x01>;
			phandle = <0x4e>;
		};
	};

	ethernet@110400000 {
		compatible = "hisilicon,higmac";
		reg = <0x01 0x10400000 0x00 0x10000 0x01 0x100c0000 0x00 0x10000 0x01 0xcf00000 0x00 0x1000>;
		interrupts = <0x00 0xca 0x04>;
		platform-type = <0x00>;
		phy-mode = "rgmii-id";
		phy-handle = <0x4e>;
		/* the MAC issues cacheable AXI transactions: map rings and buffers cacheable, as on 4.19 */
		dma-coherent;
		status = "okay";
	};

	aliases {
		mshc1 = "/dwmmc1@10CF90000";
		mmc0 = "/dwmmc1@10CF90000";
	};

	dwmmc1@10CF90000 {
		compatible = "hisilicon,ascend310-dw-mshc";
		reg = <0x01 0xcf90000 0x00 0x1000 0x01 0xc000000 0x00 0x10000 0x01 0x100c0000 0x00 0x10000>;
		interrupts = <0x00 0x27 0x04>;
		fifo-depth = <0x100>;
		clock-frequency = <3200000>;
		bus-width = <0x04>;
		cap-sd-highspeed;
		sd-uhs-sdr12;
		sd-uhs-sdr25;
		sd-uhs-sdr50;
		sd-uhs-sdr104;
		disable-wp;
		cd-gpios = <0x11 0x03 0x01>;
		vmmc-supply = <0x4d>;
		vqmmc-supply = <0x4c>;
		/* the card clock is derived from PLL5 */
		clocks = <&cpu_pll>;
		clock-names = "pll5";
		pinctrl-names = "default", "idle";
		pinctrl-0 = <0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26 0x27 0x28 0x29 0x2a 0x2b 0x2c 0x2d 0x2e 0x2f>;
