		reg = <0x01 0x100c0000 0x00 0x10000>;
	};

	lowpm_func_gic@109000000 {
		status = "disabled";
		compatible = "hisilicon,lp_gic";
		reg = <0x01 0x9000000 0x00 0x10000>;
		enable-offset = <0x104>;
		pending-offset = <0x204>;
	};

	lowpm_func_sysctrl@1100C0000 {
		status = "disabled";
		compatible = "hisilicon,lp_sysctrl";
		reg = <0x01 0x100c0000 0x00 0x10000>;
	};

