		status = "disabled";
		compatible = "hisilicon,hisi-himntn";
		himntn = "01000000";
	};

	rdr {
		compatible = "hisilicon,rdr";
		reg = <0x00 0x6e00000 0x00 0xa00000>;
		wait-dumplog-timeout = <0xea60>;
		device_flag = <0x01>;
		rdr_area_num = <0x09>;
		rdr_area_names = "AP", "DP", "DVPP", "DRIVER", "TS", "AICPU", "TEEOS", "LPM", "BIOS";
		rdr_area_sizes = <0x00 0x400000 0x10000 0x20000 0x100000 0x20000 0x20000 0x50000 0x50000>;
		status = "disabled";
	};

	rdr_lpm3_sram {
		compatible = "hisilicon,rdr-lpm3-sram";
		reg = <0x00 0x7800000 0x00 0x5400>;
		status = "disabled";
	};

	rdr_spmi {
		compatible = "hisilicon,spmi";
		reg = <0x00 0x7c80000 0x00 0x0f>;
		status = "disabled";
	};

	rdr_ddrdump_index {
		compatible = "hisilicon,rdr_ddrdump_index";
		ddrdump-index-regions = <0x03>;
		reg-names = "ts", "aicpu", "kernel";
		reg = <0x00 0x7c00000 0x00 0x10 0x00 0x7c00010 0x00 0x10 0x00 0x7c00020 0x00 0x3c0>;
		status = "disabled";
	};

	rdr_ap_adapter {
		compatible = "hisilicon,rdr_ap_adapter";
		reg-dump-regions = <0x02>;
		reg-names = "sctrl", "pmu";
		reg = <0x01 0x100c0000 0x00 0x10000 0x00 0x24d 0x00 0x0f>;
		status = "disabled";
	};

	hdr {
		compatible = "hisilicon,hdr";
		reg = <0x00 0x7880000 0x00 0x80000>;
		status = "disabled";
	};

	spmi@0x1100a0000 {
		compatible = "hisilicon,kirin970-spmi-controller";
		reg = <0x01 0x100a0000 0x00 0x1000>;
		#address-cells = <0x02>;
		#size-cells = <0x00>;
		hisilicon,spmi-channel = <0x02>;
		status = "okay";

		pmic@0 {
			compatible = "hisilicon,hi6421-spmi";
			reg = <0x00 0x00>;

			regulators {
				ldo9 {
					regulator-name = "sd_io";
					regulator-min-microvolt = <1750000>;
					regulator-max-microvolt = <3300000>;
					regulator-boot-on;
					phandle = <0x4c>;
				};

				ldo16 {
					regulator-name = "sd_vdd";
					regulator-min-microvolt = <2950000>;
					regulator-max-microvolt = <3000000>;
					regulator-boot-on;
					phandle = <0x4d>;
				};
			};
		};
	};

	hisi_usb@110600000 {
		status = "disabled";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		compatible = "hisilicon,mini-dwc3";
		reg = <0x01 0x10600000 0x00 0x100000>;
		ranges;
		dma_mask_bit = <0x40>;
		lowpower_flag = <0x00>;

		dwc3@110600000 {
			compatible = "snps,dwc3";
			reg = <0x01 0x10600000 0x00 0x100000>;
			interrupts = <0x00 0xc8 0x04>;
			maximum-speed = "super-speed";
			dma-coherent;
			dr_mode = "peripheral";
		};
	};

	tsdrv@0x1F0200000 {
		compatible = "hisi,tsdrv_device";
		interrupts = <0x00 0x129 0x01 0x00 0x12b 0x01 0x00 0x12d 0x01 0x00 0x12f 0x01 0x00 0x131 0x01 0x00 0x133 0x01 0x00 0x135 0x01 0x00 0x137 0x01 0x00 0x139 0x01 0x00 0x13b 0x01 0x00 0x13d 0x01 0x00 0x13f 0x01 0x00 0x141 0x01 0x00 0x143 0x01 0x00 0x145 0x01 0x00 0x147 0x01 0x00 0xf2 0x01>;
