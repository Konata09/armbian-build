/*
 * ADLINK DLAP-221-ATS200 (HiSilicon Ascend 310 / Hi1910)
 *
 * Derived from the vendor 4.19 device tree (board id 004) with the NPU,
 * DVPP and other vendor-only nodes disabled.
 */

/dts-v1/;

/memreserve/	0x0000000000000000 0x0000000000010000;
/ {
	compatible = "adlink,dlap-221", "hisilicon,hi1910-asic", "hisilicon,mini";
	hisi,boardid = <0x01 0x00 0x00 0x04>;
	hisi,slotid = <0x00 0x00 0x00 0x00>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	model = "ADLINK DLAP-221-ATS200";

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80000>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80100>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80200>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80300>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x05>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80400>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x06>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80500>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x07>;
		};

		cpu@6 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x80600>;
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x08>;
		};

		cpu@7 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = "", "\b\a";
			enable-method = "psci";
			cpu-release-addr = <0x00 0xfff8>;
			phandle = <0x09>;
		};

		psci {
			compatible = "arm,psci-0.2";
			method = "smc";
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};

				core2 {
					cpu = <0x08>;
				};

				core3 {
					cpu = <0x09>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpu-sleep-0 {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x28>;
				exit-latency-us = <0x46>;
				min-residency-us = <0xbb8>;
				local-timer-stop;
			};
		};
	};

	interrupt-controller@109000000 {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		interrupt-controller;
		#redistributor-regions = <0x01>;
		redistributor-stride = <0x00 0x40000>;
		reg = <0x01 0x9000000 0x00 0x10000 0x01 0x9100000 0x00 0x800000>;
		interrupts = <0x01 0x09 0xff04>;
		linux,phandle = <0x01>;
		phandle = <0x01>;

		interrupt-controller@108000000 {
			compatible = "arm,gic-v3-its";
			msi-controller;
			reg = <0x01 0x8000000 0x00 0x1000000>;
			phandle = <0x0f>;
		};
	};

	smmu_peri@102000000 {
		status = "disabled";
		compatible = "arm,smmu-v3";
		reg = <0x01 0x2000000 0x00 0x20000>;
		interrupts = <0x00 0x23 0x01 0x00 0x24 0x01 0x00 0x25 0x01>;
		interrupt-names = "eventq", "gerror", "cmdq-sync";
		#iommu-cells = <0x01>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		hisilicon,message-based-spi;
		iommu-spi-base = <0x01 0x9000040>;
		phandle = <0x0c>;
	};

	smmu_a0@140100000 {
		status = "disabled";
		compatible = "arm,smmu-v3";
		reg = <0x01 0x40100000 0x00 0x20000>;
		interrupts = <0x00 0x1cd 0x01 0x00 0x1ce 0x01 0x00 0x1cf 0x01>;
		interrupt-names = "eventq", "gerror", "cmdq-sync";
		#iommu-cells = <0x01>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		hisilicon,message-based-spi;
		iommu-spi-base = <0x01 0x9000040>;
		phandle = <0x0d>;
	};

	smmu_a1@140300000 {
		status = "disabled";
		compatible = "arm,smmu-v3";
		reg = <0x01 0x40300000 0x00 0x20000>;
		interrupts = <0x00 0x1d8 0x01 0x00 0x1d9 0x01 0x00 0x1da 0x01>;
		interrupt-names = "eventq", "gerror", "cmdq-sync";
		#iommu-cells = <0x01>;
		dma-coherent;
		hisilicon,broken-prefetch-cmd;
		hisilicon,message-based-spi;
		iommu-spi-base = <0x01 0x9000040>;
		phandle = <0x0e>;
	};

	davinci_svm {
		status = "disabled";
		compatible = "hisilicon,svm";
		reg = <0x00 0x9ffc00 0x00 0x1000>;
		memory-region = <0x0a 0x0b>;
		ranges;
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		cpu-num = <0x08>;
		interrupts = <0x00 0x118 0x01 0x00 0x119 0x01 0x00 0x11a 0x01 0x00 0x11b 0x01 0x00 0x11c 0x01 0x00 0x11d 0x01 0x00 0x11e 0x01 0x00 0x11f 0x01>;

		sdma0 {
			iommus = <0x0c 0x7f87>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		l2_pt {
			iommus = <0x0c 0x7fa6>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
			hisi,smmu_bypass;
		};

		core0 {
			iommus = <0x0d 0x7fa4>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};

		core1 {
			iommus = <0x0e 0x7fa5>;
			dma-coherent;
			dma-can-stall;
			pasid-num-bits = <0x10>;
		};
	};

	pinmux@110080000 {
		compatible = "pinctrl-single", "pinctrl-single1";
		reg = <0x01 0x10080000 0x00 0x38>;
		#gpio-range-cells = <0x03>;
		pinctrl-single,register-width = <0x20>;
		pinctrl-single,function-mask = <0x07>;

		gpio2_pmx_func {
			pinctrl-single,pins = <0x2c 0x00>;
		};

		gpio2_pmx_idle {
			pinctrl-single,pins = <0x2c 0x00>;
		};

		gpio3_pmx_func {
			pinctrl-single,pins = <0x30 0x00>;
			phandle = <0x24>;
		};

		gpio3_pmx_idle {
			pinctrl-single,pins = <0x30 0x00>;
			phandle = <0x3a>;
		};
	};

	pinmux@130900000 {
		compatible = "pinctrl-single", "pinctrl-single2";
		reg = <0x01 0x30900000 0x00 0x60>;
		#gpio-range-cells = <0x03>;
		pinctrl-single,register-width = <0x20>;
		pinctrl-single,function-mask = <0x07>;
		pinctrl-names = "default";
		pinctrl-0 = <0x47 0x48 0x49 0x4a 0x4b>;

		gpio77_pmx_func {
			pinctrl-single,pins = <0x00 0x01>;
