	opp-1896000000 {
		opp-hz = /bits/ 64 <1896000000>;
		opp-microvolt = <1225000 1225000 1300000>;
		opp-microvolt-L0 = <1225000 1225000 1300000>;
		opp-microvolt-L1 = <1225000 1225000 1300000>;
		opp-microvolt-L2 = <1225000 1225000 1300000>;
		opp-microvolt-L3 = <1225000 1225000 1300000>;
		opp-microvolt-L4 = <1225000 1225000 1300000>;
		clock-latency-ns = <40000>;
	};
	opp-2016000000 {
		opp-hz = /bits/ 64 <2016000000>;
		opp-microvolt = <1250000 1250000 1300000>;
		opp-microvolt-L0 = <1250000 1250000 1300000>;
		opp-microvolt-L1 = <1250000 1250000 1300000>;
		opp-microvolt-L2 = <1250000 1250000 1300000>;
		opp-microvolt-L3 = <1250000 1250000 1300000>;
		opp-microvolt-L4 = <1250000 1250000 1300000>;
		clock-latency-ns = <40000>;
	};
	opp-2088000000 {
		opp-hz = /bits/ 64 <2088000000>;
		opp-microvolt = <1275000 1275000 1300000>;
		opp-microvolt-L0 = <1275000 1275000 1300000>;
		opp-microvolt-L1 = <1275000 1275000 1300000>;
		opp-microvolt-L2 = <1275000 1275000 1300000>;
		opp-microvolt-L3 = <1275000 1275000 1300000>;
		opp-microvolt-L4 = <1275000 1275000 1300000>;
		clock-latency-ns = <40000>;
	};
	opp-2208000000 {
		opp-hz = /bits/ 64 <2208000000>;
		opp-microvolt = <1300000 1300000 1300000>;
		opp-microvolt-L0 = <1300000 1300000 1300000>;
		opp-microvolt-L1 = <1300000 1300000 1300000>;
		opp-microvolt-L2 = <1300000 1300000 1300000>;
		opp-microvolt-L3 = <1300000 1300000 1300000>;
		opp-microvolt-L4 = <1300000 1300000 1300000>;
		clock-latency-ns = <40000>;
	};
};
