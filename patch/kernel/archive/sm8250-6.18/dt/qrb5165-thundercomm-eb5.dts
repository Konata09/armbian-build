// SPDX-License-Identifier: BSD-3-Clause
/*
 * Thundercomm TurboX EB5U (QRB5165 / SM8250)
 *
 * 基于主线 qrb5165-rb5.dts，叠加 EB5 板级差异。
 * EB5 与 RB5 共用同一份 msm-id/board-id，SoC 侧完全兼容；
 * 差异集中在若干块载板外设的使能脚上——厂商 4.19 由闭源驱动驱动为高，
 * 主线无对应代码，故用 gpio-hog 复刻。
 */

#include "qrb5165-rb5.dts"

/ {
	model = "Thundercomm TurboX EB5U";
	compatible = "thundercomm,eb5u", "qcom,qrb5165-rb5", "qcom,sm8250";
};

/*
 * RB5 上 i2c4 是扩展排针 LS-I2C0（无板载设备）；
 * EB5 把 GPIO8/9 改作板级控制脚，其中 GPIO9 是 M.2 槽供电使能。
 */
&i2c4 {
	status = "disabled";
};

&tlmm {
	/*
	 * PCIe RC2 + 板载 ASMedia ASM2806 交换机使能。
	 * 88/89 紧邻 PCIe2 的 perst/clkreq/wake(85/86/87)。
	 * 不拉高则 RC2 链路训练失败，交换机不枚举。
	 */
	eb5_pcie_switch_hog {
		gpio-hog;
		gpios = <88  GPIO_ACTIVE_HIGH>,
			<89  GPIO_ACTIVE_HIGH>,
			<126 GPIO_ACTIVE_HIGH>,
			<130 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "eb5-pcie-switch-enable";
	};

	/*
	 * ASM2806 下游端点供电。缺失时下游端口 SltSta.PresDet=0、
	 * LnkSta.DLActive=0（端点电气不在位），三块网卡均无法枚举。
	 * 实测：GPIO9  -> 下游端口 02:00.0（M.2 槽，RTL8126）
	 *       GPIO74 -> 下游端口 02:06.0 与 02:0e.0（两颗 LAN7430）
	 */
	eb5_m2_slot_power_hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "eb5-m2-slot-power";
	};

	eb5_lan7430_power_hog {
		gpio-hog;
		gpios = <74 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "eb5-lan7430-power";
	};

	/* USB Hub 供电（厂商 4.19 亦未拉高，主线修复后 Hub 可用） */
	eb5_usb_hub_power_hog {
		gpio-hog;
		gpios = <131 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "eb5-usb-hub-power";
	};
};

/*
 * 主线 sm8250.dtsi 只为 pcie2 映射了 RID 0x000/0x100（RC 与直连端点两条）。
 * EB5 在 RC2 上挂了 ASM2806 交换机，交换机下游端口与三块网卡的 RID
 * 全部落在映射之外，DMA 会被 apps_smmu 拦下：
 *   arm-smmu 15000000.iommu: Unhandled context fault: fsr=0x402 ... SID=0x1d00
 * 表现为网卡能 link up 但收发不通（NETDEV WATCHDOG transmit timed out）。
 * 按厂商 4.19 设备树补全全部 9 条映射。
 */
&pcie2 {
	iommu-map = <0x000 &apps_smmu 0x1d00 0x1>,	/* 0002:00:00.0 根端口     */
		    <0x100 &apps_smmu 0x1d01 0x1>,	/* 0002:01:00.0 交换机上游 */
		    <0x200 &apps_smmu 0x1d02 0x1>,	/* 0002:02:00.0 下游端口   */
		    <0x230 &apps_smmu 0x1d03 0x1>,	/* 0002:02:06.0 下游端口   */
		    <0x270 &apps_smmu 0x1d04 0x1>,	/* 0002:02:0e.0 下游端口   */
		    <0x300 &apps_smmu 0x1d05 0x1>,	/* 0002:03:00.0 RTL8126    */
		    <0x400 &apps_smmu 0x1d06 0x1>,	/* 0002:04:00.0 LAN7430    */
		    <0x500 &apps_smmu 0x1d07 0x1>,	/* 0002:05:00.0 LAN7430    */
		    <0x600 &apps_smmu 0x1d08 0x1>;
};

/*
 * EB5 载板 LED。
 *
 * 主线 qrb5165-rb5.dts 里的 LED 定义在 EB5 上全部是空的（实测无对应实体灯）：
 *   - 根节点 `leds`（gpio-leds，挂 pm8150 PMIC GPIO 7/9/10）
 *     → green:user4 / yellow:wlan / blue:bt
 *   - `&pm8150l_lpg`（PMIC 的 PWM 调光控制器）
 *     → green:heartbeat-3 / green:indicator-1 / green:indicator-2
 * 这些是 RB5 开发板特有的，EB5 载板没有引出，一并删掉避免误导。
 *
 * EB5 真正的五颗灯接在 TLMM 上，主线完全没有定义，
 * 导致 /sys/class/leds/led{0..3} 不存在。
 * 厂商 4.19 设备树对应节点：/soc/leds（compatible = "gpio-leds"）
 *   led0 = tlmm 172   led1 = tlmm 173   led2 = tlmm 174   led3 = tlmm 175
 *   power_led = tlmm 75, default-state = "on"
 * 保留厂商的 label 命名，使既有的
 * /opt/max_performance.sh（echo timer > /sys/class/leds/led1/trigger）
 * 无需修改即可继续工作。
 *
 * 注：/sys/class/leds/mmc0:: 不是设备树来的，是 sdhci 驱动为 SD 控制器
 * 自动注册的活动指示灯，要去掉只能停用整个 &sdhc_2（会失去 SD 卡功能），
 * 这里保留。
 */

/* 删除 RB5 继承来的 gpio-leds（三颗都无实体） */
/ {
	/delete-node/ leds;
};

/* 停用 PMIC LPG——RB5 用它驱动三颗指示灯，EB5 没引出，且无其它 PWM 消费者 */
&pm8150l_lpg {
	status = "disabled";
};

/ {
	eb5_leds: leds-eb5 {
		compatible = "gpio-leds";

		led-0 {
			label = "led0";
			gpios = <&tlmm 172 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-1 {
			label = "led1";
			gpios = <&tlmm 173 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-2 {
			label = "led2";
			gpios = <&tlmm 174 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-3 {
			label = "led3";
			gpios = <&tlmm 175 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		led-power {
			label = "power_led";
			gpios = <&tlmm 75 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};
};

/*
 * USB0（usb_1 / a600000）改为主机模式。
 *
 * 主线 qrb5165-rb5.dts 把 USB0 配成 `dr_mode = "otg"` + `usb-role-switch`，
 * 因为 RB5 上它是 Type-C 口，靠 PMIC 的 Type-C 控制器协商主/从角色。
 * EB5 上这一路不是 Type-C，而是**硬接了一颗 TI TUSB8044A 4 口 USB Hub**，
 * 没有任何角色协商信号源，于是 role 永远停在未定态：
 *   - dwc3 不会实例化 xhci 子设备（/sys/.../a600000.usb 下只有 usb_role）
 *   - /sys/class/usb_role/a600000.usb-role-switch/role 只读且为空
 *   - Hub 虽有 VBUS（gpio131 已拉高，插 U 盘会发热）但主机侧根本没枚举
 * 厂商 4.19 的设备树是 `dr_mode = "drd"`，同样依赖协商，
 * 所以**原厂系统里这个 Hub 也一直不工作**。
 *
 * 固定成 host 即可让 dwc3 直接进主机模式并创建 xhci。
 */
&usb_1_dwc3 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
};

/*
 * LT9611UXC（DSI → HDMI 桥）整条链路关闭。
 *
 * EB5 是没有显示输出的边缘盒子，RB5 继承来的这颗桥片派不上用场。
 * 生产内核（6.18.40）直接关掉了 DRM_MSM，所以从来没碰过它；
 * 而 Armbian 的 sm8250 配置里 DRM_MSM/DRM_MSM_DSI 都是 =y，
 * 不处理的话 DSI0 会去驱动这颗桥，白白把显示链路拉起来。
 *
 * ⚠️ 删除顺序有讲究：必须先摘掉外部对 lt9611 各 label 的引用，再删节点本身，
 * 否则 DTC 解析 phandle 时会因为找不到目标而编译失败。
 * RB5 里一共有五处引用：vdd-supply / vcc-supply（节点内部，随节点一起消失）、
 * mdss_dsi0_out 的 remote-endpoint、sound 的 hdmi-dai-link，
 * 以及 hdmi-out 连接器节点里指向 lt9611_out 的 endpoint。
 */

/* 1) DSI0 输出端点，原本指向 &lt9611_a */
&mdss_dsi0_out {
	/delete-property/ remote-endpoint;
};

/* 2) HDMI 音频 dai-link，原本引用 <&lt9611_codec 0> */
&sound {
	/delete-node/ hdmi-dai-link;
};

/* 3) 桥本身。RB5 的 i2c5 上只挂了这一个设备，总线一并停掉 */
&i2c5 {
	status = "disabled";
	/delete-node/ hdmi-bridge@2b;
};

/* 4) DSI0 已经没有接收端，停掉控制器和 PHY，免得 DRM 反复 EPROBE_DEFER */
&mdss_dsi0 {
	status = "disabled";
};

&mdss_dsi0_phy {
	status = "disabled";
};

/*
 * 5) 两路专供 LT9611 的稳压器。
 *
 * 注意它们是 regulator-fixed 且没有 gpio 属性 —— 也就是说板级供电是硬连到
 * vdc_3v3 上的，设备树里没有任何手段真正切断这两路电。删除节点的实际作用是
 * 解除内核侧的引用，尤其是撤掉 LT9611_3V3 上的 regulator-always-on/boot-on
 * （否则 regulator 框架开机就会把这个虚拟稳压器置成 enabled 并一直保持）。
 */
/ {
	/* hdmi-connector：它的 endpoint 指向 lt9611 的 port@2 (&lt9611_out)，
	   桥都没了，这个连接器自然也留不得 */
	/delete-node/ hdmi-out;

	/delete-node/ lt9611-vdd12-regulator;
	/delete-node/ lt9611-3v3;
};

/*
 * 6) 真正能关掉的"使能"是复位脚。
 *
 * RB5 用 pm8150l_gpios 5 作 LT9611 的 RESETN（reset-gpios 声明为
 * GPIO_ACTIVE_HIGH，驱动要置 1 才算释放复位）。实测 EB5 上这个脚被引导加载器
 * 置成 out-high —— pm8150l 的 12 个 GPIO 里只有 gpio2 和 gpio5 是输出 ——
 * 也就是说桥片一直处在"已释放复位"的运行态。
 *
 * 这里用 gpio-hog 把它固定拉低，让桥片保持复位、不再工作，
 * 顺便也把这个脚占住，避免被别的驱动误申请。
 */
&pm8150l_gpios {
	eb5_lt9611_reset_hog {
		gpio-hog;
		gpios = <5 GPIO_ACTIVE_HIGH>;
		output-low;
		line-name = "lt9611_reset_assert";
	};
};
